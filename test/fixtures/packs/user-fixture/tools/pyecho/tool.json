{
  "name": "pyecho",
  "description": "Echoes args back from Python",
  "runtime": "python",
  "entry": "main.py",
  "commands": {
    "pyecho": {
      "description": "Echo args as JSON",
      "args": {
        "type": "object",
        "properties": { "msg": { "type": "string" }, "n": { "type": "integer" } },
        "required": ["msg"]
      },
      "positional": ["msg"]
    },
    "pyecho-fail": { "description": "Exit with the auth code" }
  }
}
